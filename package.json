  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
